# PostgreSQL connection used by Prisma 7 and the NestJS API.
DATABASE_URL="postgresql://trustexam:replace-me@localhost:5432/trustexam?schema=public"

# Required only when running the demo seed; do not use this account in production.
DEMO_OWNER_EMAIL="owner@example.invalid"
DEMO_OWNER_NAME="Demo Organization Owner"
DEMO_OWNER_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"

# Auth emails use local Mailpit by default; production credentials belong only in the environment.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="TrustExam Pro <no-reply@example.invalid>"
# Use HTTPS for AUTH_PUBLIC_URL in production.
AUTH_PUBLIC_URL="http://localhost:3000"
AUTH_SESSION_TTL_SECONDS="28800"
AUTH_COOKIE_SECURE="false"
AUTH_VERIFICATION_TTL_HOURS="24"
AUTH_PASSWORD_RESET_TTL_MINUTES="60"
AUTH_RATE_WINDOW_SECONDS="900"
AUTH_RATE_SIGNUP_LIMIT="5"
AUTH_RATE_SIGNIN_LIMIT="10"
AUTH_RATE_RESET_LIMIT="5"
AUTH_RATE_VERIFY_LIMIT="20"
