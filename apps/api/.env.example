# Copy to .env for local development. Values match infra/docker-compose.yml.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://trustexam:trustexam@localhost:5432/trustexam?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=trustexam-evidence
S3_ACCESS_KEY_ID=trustexam
S3_SECRET_ACCESS_KEY=trustexam-secret
S3_FORCE_PATH_STYLE=true

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="TrustExam <no-reply@trustexam.local>"
