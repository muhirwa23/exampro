{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrustExam Pro",
  "version": "0.1.0",
  "identifier": "com.trustexam.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @trustexam/desktop-ui dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @trustexam/desktop-ui build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TrustExam Pro",
        "width": 1024,
        "height": 768,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
